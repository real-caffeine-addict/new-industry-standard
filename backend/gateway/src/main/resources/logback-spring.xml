<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true">

    <!-- ================================================================== -->
    <!--  2. JSON ENCODER FOR ELK/SIEM                                      -->
    <!-- ================================================================== -->
    <!-- Produces one JSON log entry per line (ELK-friendly) -->
    <appender name="JSON_LOG" class="ch.qos.logback.core.ConsoleAppender">

        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <timeZone>UTC</timeZone>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</pattern>
                </timestamp>
                <logLevel />
                <threadName />
                <loggerName />
                <message />
                <mdc />
                <arguments />
            </providers>
        </encoder>
    </appender>

    <appender name="ROOT_APPENDER" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ================================================================== -->
    <!--  4. LOGGERS                                                        -->
    <!-- ================================================================== -->

    <logger name="logRequest" level="INFO" additivity="false">
        <appender-ref ref="JSON_LOG" />
    </logger>

    <logger name="alertLogger" level="INFO" additivity="false">
        <appender-ref ref="JSON_LOG" />
    </logger>

    <root name="root" level="INFO">
        <appender-ref ref="ROOT_APPENDER" />
    </root>
</configuration>